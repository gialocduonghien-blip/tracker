// notification-sw.js

self.addEventListener("install", (event) => {
    self.skipWaiting();
});

self.addEventListener("activate", (event) => {
    event.waitUntil(self.clients.claim());
});

// Nhận push notification
self.addEventListener("push", (event) => {
    let data = {};

    try {
        data = event.data ? event.data.json() : {};
    } catch (e) {
        data = {
            title: "Gia Lộc Tracker",
            body: event.data ? event.data.text() : "Bạn có thông báo mới."
        };
    }

    const title = data.title || "📍 Gia Lộc Tracker";

    const options = {
        body: data.body || "Gia Lộc vừa cập nhật vị trí.",
        icon: data.icon || "https://cdn-icons-png.flaticon.com/512/3135/3135715.png",
        badge: data.badge || "https://cdn-icons-png.flaticon.com/512/3135/3135715.png",
        tag: data.tag || "gialoc-tracker",
        renotify: true,
        requireInteraction: false,
        vibrate: [250, 150, 250],
        data: {
            url: data.url || data.mapLink || "./2.html",
            mapLink: data.mapLink || ""
        }
    };

    event.waitUntil(
        self.registration.showNotification(title, options)
    );
});

// Khi người dùng bấm vào notification
self.addEventListener("notificationclick", (event) => {
    event.notification.close();

    const data = event.notification.data || {};
    const targetUrl = data.mapLink || data.url || "./2.html";

    event.waitUntil(
        clients.matchAll({
            type: "window",
            includeUncontrolled: true
        }).then((clientList) => {

            // Nếu app đang mở thì đưa app lên trước
            for (const client of clientList) {
                if ("focus" in client) {
                    return client.focus().then(() => {
                        if ("navigate" in client && targetUrl) {
                            return client.navigate(targetUrl);
                        }
                    });
                }
            }

            // Nếu app chưa mở thì mở mới
            if (clients.openWindow) {
                return clients.openWindow(targetUrl);
            }
        })
    );
});

// Khi notification bị đóng
self.addEventListener("notificationclose", (event) => {
    // Có thể thêm analytics sau này nếu cần
});
